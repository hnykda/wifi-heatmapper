{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiFi Heatmapper",
  "mainBinaryName": "wifi-heatmapper",
  "version": "../../package.json",
  "identifier": "com.github.hnykda.wifi-heatmapper",
  "build": {
    "frontendDist": "../launcher",
    "beforeDevCommand": {
      "script": "node build-server.mjs",
      "wait": true
    },
    "beforeBuildCommand": "node build-server.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Wi-Fi signal and throughput heat maps",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server/": "server/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
