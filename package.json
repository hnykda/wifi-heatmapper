{
  "name": "wifi-heatmapper",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --fix src __tests__ e2e playwright.config.ts && prettier --write src __tests__ e2e playwright.config.ts",
    "check": "oxlint src __tests__ e2e playwright.config.ts && prettier --check src __tests__ e2e playwright.config.ts",
    "dev:mock": "cross-env WIFI_HEATMAPPER_MOCK=1 next dev --turbopack",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:serve:dev": "cross-env WIFI_HEATMAPPER_MOCK=1 WIFI_HEATMAPPER_DATA_DIR=.e2e-data NEXT_DIST_DIR=.next-e2e next dev -p 3100",
    "e2e:serve:prod": "cross-env WIFI_HEATMAPPER_MOCK=1 WIFI_HEATMAPPER_DATA_DIR=.e2e-data NEXT_DIST_DIR=.next-e2e next start -p 3100",
    "verify": "npm run check && npm run typecheck && npm run test",
    "e2e:build": "cross-env NEXT_DIST_DIR=.next-e2e next build",
    "desktop:install": "npm --prefix desktop ci --no-audit --no-fund",
    "desktop:server": "node desktop/build-server.mjs",
    "desktop:smoke": "node desktop/smoke-test.mjs",
    "desktop:dev": "npm run desktop:install && npm --prefix desktop run dev",
    "desktop:dev:mock": "cross-env WIFI_HEATMAPPER_MOCK=1 npm run desktop:dev",
    "desktop:build": "npm run desktop:install && npm --prefix desktop run build",
    "build:macos-helper": "node native/macos-wifi-helper/build.mjs",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp": "node scripts/build-mcp.mjs && node dist/mcp/wifi-heatmapper-mcp.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "is-docker": "^4.0.0",
    "is-podman": "^1.0.1",
    "koffi": "^2.16.3",
    "lucide-react": "^0.513.0",
    "nanoid": "^5.1.16",
    "next": "^15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tslog": "^4.11.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.25.5",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
